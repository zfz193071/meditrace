# 示例环境变量文件
# 复制此文件并修改为 .env
# ⚠️ 注意：.env 文件包含敏感信息，切勿提交到 Git！

# ==================== 区块链配置 ====================

# Sepolia 测试网 RPC URL
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 私钥（用于部署和交易，注意安全！）
# 从 MetaMask 导出：设置 → 安全与隐私 → 导出私钥
SEPOLIA_PRIVATE_KEY=your_private_key_here

# 合约地址（部署后自动填充或手动填写）
CONTRACT_ADDRESS_SEPOLIA=

# Etherscan API Key（用于合约验证，可选）
# 从 https://etherscan.io/myapikey 获取
ETHERSCAN_API_KEY=

# ==================== 本地开发配置 ====================

# 本地 Hardhat 节点 RPC URL
BLOCKCHAIN_RPC_URL=http://localhost:8545

# 本地部署的合约地址
CONTRACT_ADDRESS=
