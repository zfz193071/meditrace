    "@types/jest": "30.0.0",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.5.4",
    "eslint": "10.13.0",
    "@next/eslint-plugin-next": "16.4.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript-eslint": "8.72.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "openapi-typescript": "7.13.0",
