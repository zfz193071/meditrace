# 生产环境配置 - Vercel Services 架构（前端 + Python 后端同一域名）
#
# ⚠️ NEXT_PUBLIC_BACKEND_URL 必须是「源地址」，不能写成 /api：
#    前端代码统一拼接为 ${NEXT_PUBLIC_BACKEND_URL}/api/xxx，
#    若这里写 /api，会拼成 /api/api/xxx 而必然 404。
#
# 该变量是构建期内联值；Vercel 控制台的同名环境变量优先级更高，
# 修改后必须重新部署才会生效。
NEXT_PUBLIC_BACKEND_URL=https://meditrace.baozaolaoba.top
NEXT_PUBLIC_CONTRACT_ADDRESS=0x860418e7713A346c829Bc539C93c7A2d576897C5
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
