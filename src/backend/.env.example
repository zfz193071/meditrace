# 示例环境变量文件
# 复制此文件并修改为 .env
# ⚠️ 注意：.env 文件包含敏感信息，切勿提交到 Git！

# ==================== AI 配置 ====================

# DeepSeek API 密钥
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# ==================== 区块链配置 ====================

# 智能合约地址（部署后填写）
CONTRACT_ADDRESS_SEPOLIA=

# 区块链 RPC URL（本地或测试网）
BLOCKCHAIN_RPC_URL=http://localhost:8545

# 用户钱包地址（用于测试，实际生产应集成 MetaMask）
USER_WALLET_ADDRESS=0x...

# ==================== IPFS 配置（Pinata）====================

# Pinata API Key 和 Secret
# 从 https://pinata.cloud 获取
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Pinata JWT Token（推荐方式，比 API Key 更安全）
PINATA_JWT_TOKEN=

# ==================== 服务器配置 ====================

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# 服务器端口
PORT=8000

# ==================== Referral Review V1 ====================
# 所有变量只在后端运行时读取；详细条件见 docs/referral-review/CONFIGURATION.md。
# 未配置时只提供 foundation capabilities；真实 AI、支付和工作区均不可用。
RR_ENVIRONMENT=development
RR_MODE=bundled_demo
DATABASE_URL=
RR_SITE_ORIGIN=
RR_GITHUB_CLIENT_ID=
RR_GITHUB_CLIENT_SECRET=
RR_GITHUB_CALLBACK_URL=
# Fernet key：32 个随机字节的 URL-safe Base64 编码；不能填写普通口令。
# 使用方式见 docs/referral-review/AUTHENTICATION.md，不要将实际值提交到仓库。
RR_SESSION_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=
RR_STORAGE_BACKEND=disabled
# local is development/test only; use an absolute private directory outside the repository.
RR_PRIVATE_STORAGE_DIR=
RR_STORAGE_GLOBAL_BYTES=1073741824
RR_STRIPE_SECRET_KEY=
RR_STRIPE_WEBHOOK_SECRET=
RR_STRIPE_PRICE_ID=
RR_STRIPE_AMOUNT_MINOR=0
RR_STRIPE_CURRENCY=usd
REAL_AI_ENABLED=false
RR_MODEL_ID=
RR_MODEL_PRICE_VERSION=
RR_MODEL_INPUT_MICROUSD_PER_MILLION_TOKENS=0
RR_MODEL_OUTPUT_MICROUSD_PER_MILLION_TOKENS=0
RR_DAILY_BUDGET_MICROUSD=0
RR_MONTHLY_BUDGET_MICROUSD=0
RR_REAL_AI_USER_IDS=
RR_MAINTENANCE_TOKEN=
