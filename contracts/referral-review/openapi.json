{
  "components": {
    "schemas": {
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "demo_cases_available": {
            "const": false,
            "default": false,
            "title": "Demo Cases Available",
            "type": "boolean"
          },
          "demo_mode_available": {
            "const": true,
            "default": true,
            "title": "Demo Mode Available",
            "type": "boolean"
          },
          "limits": {
            "$ref": "#/components/schemas/InputLimits"
          },
          "mode": {
            "enum": [
              "bundled_demo",
              "sandbox",
              "invited_real"
            ],
            "title": "Mode",
            "type": "string"
          },
          "payment_environment": {
            "const": "test",
            "default": "test",
            "title": "Payment Environment",
            "type": "string"
          },
          "payments_available": {
            "const": false,
            "default": false,
            "title": "Payments Available",
            "type": "boolean"
          },
          "real_ai_execution_available": {
            "const": false,
            "default": false,
            "title": "Real Ai Execution Available",
            "type": "boolean"
          },
          "sandbox_execution_available": {
            "const": false,
            "default": false,
            "title": "Sandbox Execution Available",
            "type": "boolean"
          },
          "stage": {
            "const": "foundation",
            "default": "foundation",
            "title": "Stage",
            "type": "string"
          },
          "synthetic_data_only": {
            "const": true,
            "default": true,
            "title": "Synthetic Data Only",
            "type": "boolean"
          },
          "workspace_available": {
            "const": false,
            "default": false,
            "title": "Workspace Available",
            "type": "boolean"
          }
        },
        "required": [
          "contract_version",
          "mode"
        ],
        "title": "Capabilities",
        "type": "object"
      },
      "DocumentResponse": {
        "additionalProperties": false,
        "properties": {
          "byte_size": {
            "minimum": 0.0,
            "title": "Byte Size",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "pdf",
              "text"
            ],
            "title": "Kind",
            "type": "string"
          },
          "packet_id": {
            "format": "uuid",
            "title": "Packet Id",
            "type": "string"
          },
          "parse_status": {
            "enum": [
              "uploading",
              "parsing",
              "ready",
              "rejected",
              "failed"
            ],
            "title": "Parse Status",
            "type": "string"
          },
          "parser_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parser Version"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "packet_id",
          "kind",
          "filename",
          "byte_size",
          "sha256",
          "parse_status",
          "parser_version",
          "created_at"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "AUTH_REQUIRED",
          "FORBIDDEN",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "SCHEMA_INVALID",
          "REAL_AI_NOT_ALLOWED",
          "SERVICE_NOT_READY",
          "INTERNAL_ERROR",
          "OAUTH_FAILED",
          "FILE_UNSUPPORTED",
          "FILE_TOO_LARGE",
          "STORAGE_LIMIT",
          "DOCUMENT_LIMIT",
          "STORAGE_UNAVAILABLE",
          "IDEMPOTENCY_CONFLICT"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "end_cp": {
            "exclusiveMinimum": 0,
            "title": "End Cp",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "page_number": {
            "minimum": 1,
            "title": "Page Number",
            "type": "integer"
          },
          "quote": {
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "start_cp": {
            "minimum": 0,
            "title": "Start Cp",
            "type": "integer"
          },
          "text_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Text Hash",
            "type": "string"
          }
        },
        "required": [
          "id",
          "document_id",
          "page_number",
          "start_cp",
          "end_cp",
          "quote",
          "text_hash"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "assertion_status": {
            "enum": [
              "stated",
              "explicitly_none",
              "unknown"
            ],
            "title": "Assertion Status",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "field_key": {
            "$ref": "#/components/schemas/FieldKey"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "temporal_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temporal Context"
          },
          "value_normalized": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value Normalized"
          },
          "value_raw": {
            "minLength": 1,
            "title": "Value Raw",
            "type": "string"
          }
        },
        "required": [
          "id",
          "field_key",
          "value_raw",
          "assertion_status",
          "evidence_ids"
        ],
        "title": "Fact",
        "type": "object"
      },
      "FieldKey": {
        "enum": [
          "patient.name",
          "patient.dob",
          "referrer.name",
          "referrer.contact",
          "recipient",
          "referral.reason",
          "medications",
          "allergies",
          "attachment_reference",
          "report.description"
        ],
        "title": "FieldKey",
        "type": "string"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "checked_document_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Checked Document Ids",
            "type": "array"
          },
          "checklist_version": {
            "title": "Checklist Version",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "fact_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Fact Ids",
            "type": "array"
          },
          "field_keys": {
            "items": {
              "$ref": "#/components/schemas/FieldKey"
            },
            "minItems": 1,
            "title": "Field Keys",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "missing",
              "unknown",
              "identity_mismatch",
              "statement_difference",
              "attachment_unmatched",
              "parse_quality"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "rule_id": {
            "pattern": "^C0[1-8]$",
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule_id",
          "checklist_version",
          "kind",
          "field_keys",
          "checked_document_ids",
          "message"
        ],
        "title": "Finding",
        "type": "object"
      },
      "InputLimits": {
        "additionalProperties": false,
        "properties": {
          "max_documents": {
            "default": 5,
            "exclusiveMinimum": 0.0,
            "title": "Max Documents",
            "type": "integer"
          },
          "max_input_tokens": {
            "default": 16000,
            "exclusiveMinimum": 0.0,
            "title": "Max Input Tokens",
            "type": "integer"
          },
          "max_output_tokens": {
            "default": 6000,
            "exclusiveMinimum": 0.0,
            "title": "Max Output Tokens",
            "type": "integer"
          },
          "max_packet_codepoints": {
            "default": 30000,
            "exclusiveMinimum": 0.0,
            "title": "Max Packet Codepoints",
            "type": "integer"
          },
          "max_packet_pdf_bytes": {
            "default": 10485760,
            "exclusiveMinimum": 0.0,
            "title": "Max Packet Pdf Bytes",
            "type": "integer"
          },
          "max_pages": {
            "default": 25,
            "exclusiveMinimum": 0.0,
            "title": "Max Pages",
            "type": "integer"
          },
          "max_pdf_bytes": {
            "default": 2097152,
            "exclusiveMinimum": 0.0,
            "title": "Max Pdf Bytes",
            "type": "integer"
          },
          "max_text_codepoints": {
            "default": 10000,
            "exclusiveMinimum": 0.0,
            "title": "Max Text Codepoints",
            "type": "integer"
          }
        },
        "title": "InputLimits",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checklist_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checklist Version"
          },
          "checks": {
            "additionalProperties": {
              "enum": [
                "ready",
                "not_checked",
                "not_implemented",
                "unavailable"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "schema_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Version"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "schema_version",
          "checklist_version",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReviewResult": {
        "additionalProperties": false,
        "description": "A completed result, not a pending job; no invented execution endpoints in MT-01.",
        "properties": {
          "checklist_version": {
            "title": "Checklist Version",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "title": "Facts",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "mode": {
            "enum": [
              "precomputed",
              "fake",
              "replay",
              "real"
            ],
            "title": "Mode",
            "type": "string"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "revision_id",
          "mode",
          "created_at",
          "checklist_version",
          "prompt_version",
          "schema_version",
          "facts",
          "evidence",
          "findings"
        ],
        "title": "ReviewResult",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "outcome_unknown",
          "cancelled"
        ],
        "title": "RunState",
        "type": "string"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "csrf_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Csrf Token"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "login_available": {
            "default": false,
            "title": "Login Available",
            "type": "boolean"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionUser"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "SessionResponse",
        "type": "object"
      },
      "SessionUser": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "display_name"
        ],
        "title": "SessionUser",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Referral identity and private document storage. Parsing, packet, review, model and payment workflows are not complete yet.",
    "title": "MediTrace Referral Review API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/github/callback": {
      "get": {
        "operationId": "complete_github_login",
        "responses": {
          "303": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Callback"
      }
    },
