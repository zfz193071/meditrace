{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "end_cp": {
          "exclusiveMinimum": 0,
          "title": "End Cp",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start_cp": {
          "minimum": 0,
          "title": "Start Cp",
          "type": "integer"
        },
        "text_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "document_id",
        "page_number",
        "start_cp",
        "end_cp",
        "quote",
        "text_hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "assertion_status": {
          "enum": [
            "stated",
            "explicitly_none",
            "unknown"
          ],
          "title": "Assertion Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "field_key": {
          "$ref": "#/$defs/FieldKey"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "temporal_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Context"
        },
        "value_normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Normalized"
        },
        "value_raw": {
          "minLength": 1,
          "title": "Value Raw",
          "type": "string"
        }
      },
      "required": [
        "id",
        "field_key",
        "value_raw",
        "assertion_status",
        "evidence_ids"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FieldKey": {
      "enum": [
        "patient.name",
        "patient.dob",
        "referrer.name",
        "referrer.contact",
        "recipient",
        "referral.reason",
        "medications",
        "allergies",
        "attachment_reference",
        "report.description"
      ],
      "title": "FieldKey",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "checked_document_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Checked Document Ids",
          "type": "array"
        },
        "checklist_version": {
          "title": "Checklist Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "field_keys": {
          "items": {
            "$ref": "#/$defs/FieldKey"
          },
          "minItems": 1,
          "title": "Field Keys",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "missing",
            "unknown",
            "identity_mismatch",
            "statement_difference",
            "attachment_unmatched",
            "parse_quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^C0[1-8]$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "checklist_version",
        "kind",
        "field_keys",
        "checked_document_ids",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "ReviewResult": {
      "additionalProperties": false,
      "description": "A completed result, not a pending job; no invented execution endpoints in MT-01.",
      "properties": {
        "checklist_version": {
          "title": "Checklist Version",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "title": "Facts",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "mode": {
          "enum": [
            "precomputed",
            "fake",
            "replay",
            "real"
          ],
          "title": "Mode",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "title": "Revision Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "revision_id",
        "mode",
        "created_at",
        "checklist_version",
        "prompt_version",
        "schema_version",
        "facts",
        "evidence",
        "findings"
      ],
      "title": "ReviewResult",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "outcome_unknown",
        "cancelled"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/Fact"
    },
    {
      "$ref": "#/$defs/Finding"
    },
    {
      "$ref": "#/$defs/ReviewResult"
    },
    {
      "$ref": "#/$defs/RunState"
    }
  ],
  "title": "MediTrace referral domain contracts",
  "x-contract-version": "0.1.0"
}
