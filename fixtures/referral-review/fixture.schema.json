{
  "checklist": {
    "$defs": {
      "FieldKey": {
        "enum": [
          "patient.name",
          "patient.dob",
          "referrer.name",
          "referrer.contact",
          "recipient",
          "referral.reason",
          "medications",
          "allergies",
          "attachment_reference",
          "report.description"
        ],
        "title": "FieldKey",
        "type": "string"
      },
      "Rule": {
        "additionalProperties": false,
        "properties": {
          "fields": {
            "items": {
              "$ref": "#/$defs/FieldKey"
            },
            "minItems": 1,
            "title": "Fields",
            "type": "array"
          },
          "id": {
            "pattern": "^C0[1-8]$",
            "title": "Id",
            "type": "string"
          },
          "presence": {
            "enum": [
              "all",
              "any",
              "explicit_attachment_only"
            ],
            "title": "Presence",
            "type": "string"
          },
          "requirement": {
            "title": "Requirement",
            "type": "string"
          },
          "safeguards": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Safeguards",
            "type": "array"
          },
          "unknown_behavior": {
            "default": "preserve",
            "enum": [
              "preserve",
              "clarify"
            ],
            "title": "Unknown Behavior",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fields",
          "requirement",
          "presence",
          "safeguards"
        ],
        "title": "Rule",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "clinical_standard": {
        "const": false,
        "title": "Clinical Standard",
        "type": "boolean"
      },
      "demonstration_only": {
        "const": true,
        "title": "Demonstration Only",
        "type": "boolean"
      },
      "rules": {
        "items": {
          "$ref": "#/$defs/Rule"
        },
        "title": "Rules",
        "type": "array"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "version": {
        "const": "outpatient-referral-demo@1",
        "title": "Version",
        "type": "string"
      }
    },
    "required": [
      "version",
      "title",
      "demonstration_only",
      "clinical_standard",
      "rules"
    ],
    "title": "Checklist",
    "type": "object"
  },
  "demo_review": {
    "$defs": {
      "Resolution": {
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "format": "uuid",
            "title": "Finding Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "dismissed",
              "unresolved"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "status"
        ],
        "title": "Resolution",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "confirmed_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Confirmed At"
      },
      "has_unresolved": {
        "title": "Has Unresolved",
        "type": "boolean"
      },
      "heading": {
        "title": "Heading",
        "type": "string"
      },
      "identity_unresolved": {
        "title": "Identity Unresolved",
        "type": "boolean"
      },
      "illustrative_not_actual_review": {
        "const": true,
        "title": "Illustrative Not Actual Review",
        "type": "boolean"
      },
      "packet_id": {
        "format": "uuid",
        "title": "Packet Id",
        "type": "string"
      },
      "resolutions": {
        "items": {
          "$ref": "#/$defs/Resolution"
        },
        "title": "Resolutions",
        "type": "array"
      },
      "review_version": {
        "minimum": 0,
        "title": "Review Version",
        "type": "integer"
      },
      "revision_id": {
        "format": "uuid",
        "title": "Revision Id",
        "type": "string"
      },
      "run_id": {
        "format": "uuid",
        "title": "Run Id",
        "type": "string"
      },
      "schema_version": {
        "const": "demo-review-fixture-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
        "enum": [
          "draft",
          "confirmed"
        ],
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "illustrative_not_actual_review",
      "packet_id",
      "run_id",
      "revision_id",
      "review_version",
      "status",
      "resolutions",
      "confirmed_at",
      "has_unresolved",
      "identity_unresolved",
      "heading"
    ],
    "title": "DemoReview",
    "type": "object"
  },
  "manifest": {
    "$defs": {
      "Entry": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "packet_path": {
            "title": "Packet Path",
            "type": "string"
          },
          "public_demo": {
            "title": "Public Demo",
            "type": "boolean"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "split": {
            "enum": [
              "dev",
              "test"
            ],
            "title": "Split",
            "type": "string"
          }
        },
        "required": [
          "key",
          "split",
          "packet_path",
          "sha256",
          "public_demo"
        ],
        "title": "Entry",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "annotation_status": {
        "const": "provisional_operator_review_pending",
        "title": "Annotation Status",
        "type": "string"
      },
      "checklist_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Checklist Sha256",
        "type": "string"
      },
      "checklist_version": {
        "const": "outpatient-referral-demo@1",
        "title": "Checklist Version",
        "type": "string"
      },
      "corpus_version": {
        "const": "synthetic-referral@1",
        "title": "Corpus Version",
        "type": "string"
      },
      "entries": {
        "items": {
          "$ref": "#/$defs/Entry"
        },
        "title": "Entries",
        "type": "array"
      },
      "files": {
        "additionalProperties": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "title": "Files",
        "type": "object"
      },
      "generator_version": {
        "title": "Generator Version",
        "type": "string"
      },
      "parser_version": {
        "title": "Parser Version",
        "type": "string"
      },
      "schema_version": {
        "const": "fixture-manifest-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "test_split_policy": {
        "const": "held_out_from_prompts_not_secret",
        "title": "Test Split Policy",
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "corpus_version",
      "checklist_version",
      "checklist_sha256",
      "annotation_status",
      "test_split_policy",
      "parser_version",
      "generator_version",
      "entries",
      "files"
    ],
    "title": "Manifest",
    "type": "object"
  },
  "packet": {
    "$defs": {
      "Document": {
        "additionalProperties": false,
        "properties": {
          "byte_size": {
            "exclusiveMinimum": 0,
            "title": "Byte Size",
            "type": "integer"
          },
          "expected_gate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expected Gate"
          },
          "fixture_variant": {
            "title": "Fixture Variant",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "pdf",
              "text"
            ],
            "title": "Kind",
            "type": "string"
          },
          "pages": {
            "items": {
              "$ref": "#/$defs/Page"
            },
            "title": "Pages",
            "type": "array"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "source_path": {
            "title": "Source Path",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "source_path",
          "sha256",
          "byte_size",
          "pages",
          "fixture_variant"
        ],
        "title": "Document",
        "type": "object"
      },
      "Evidence": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "end_cp": {
            "exclusiveMinimum": 0,
            "title": "End Cp",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "page_number": {
            "minimum": 1,
            "title": "Page Number",
            "type": "integer"
          },
          "quote": {
            "minLength": 1,
            "title": "Quote",
            "type": "string"
          },
          "start_cp": {
            "minimum": 0,
            "title": "Start Cp",
            "type": "integer"
          },
          "text_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Text Hash",
            "type": "string"
          }
        },
        "required": [
          "id",
          "document_id",
          "page_number",
          "start_cp",
          "end_cp",
          "quote",
          "text_hash"
        ],
        "title": "Evidence",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "properties": {
          "assertion_status": {
            "enum": [
              "stated",
              "explicitly_none",
              "unknown"
            ],
            "title": "Assertion Status",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Evidence Ids",
            "type": "array"
          },
          "field_key": {
            "$ref": "#/$defs/FieldKey"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "temporal_context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Temporal Context"
          },
          "value_normalized": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value Normalized"
          },
          "value_raw": {
            "minLength": 1,
            "title": "Value Raw",
            "type": "string"
          }
        },
        "required": [
          "id",
          "field_key",
          "value_raw",
          "assertion_status",
          "evidence_ids"
        ],
        "title": "Fact",
        "type": "object"
      },
      "FieldKey": {
        "enum": [
          "patient.name",
          "patient.dob",
          "referrer.name",
          "referrer.contact",
          "recipient",
          "referral.reason",
          "medications",
          "allergies",
          "attachment_reference",
          "report.description"
        ],
        "title": "FieldKey",
        "type": "string"
      },
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "checked_document_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Checked Document Ids",
            "type": "array"
          },
          "checklist_version": {
            "title": "Checklist Version",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "fact_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Fact Ids",
            "type": "array"
          },
          "field_keys": {
            "items": {
              "$ref": "#/$defs/FieldKey"
            },
            "minItems": 1,
            "title": "Field Keys",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "missing",
              "unknown",
              "identity_mismatch",
              "statement_difference",
              "attachment_unmatched",
              "parse_quality"
            ],
            "title": "Kind",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "rule_id": {
            "pattern": "^C0[1-8]$",
            "title": "Rule Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule_id",
          "checklist_version",
          "kind",
          "field_keys",
          "checked_document_ids",
          "message"
        ],
        "title": "Finding",
        "type": "object"
      },
      "Gold": {
        "additionalProperties": false,
        "properties": {
          "automated_review_allowed": {
            "title": "Automated Review Allowed",
            "type": "boolean"
          },
          "checklist": {
            "additionalProperties": {
              "enum": [
                "satisfied",
                "missing",
                "needs_clarification",
                "needs_review",
                "not_applicable",
                "blocked"
              ],
              "type": "string"
            },
            "title": "Checklist",
            "type": "object"
          },
          "expected_rejection": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Rejection"
          },
          "operator_review": {
            "const": "pending",
            "default": "pending",
            "title": "Operator Review",
            "type": "string"
          },
          "rationale_by_id": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Rationale By Id",
            "type": "object"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/$defs/ReviewResult"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "automated_review_allowed",
          "expected_rejection",
          "result",
          "checklist",
          "rationale_by_id"
        ],
        "title": "Gold",
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "number": {
            "minimum": 1,
            "title": "Number",
            "type": "integer"
          },
          "quality": {
            "enum": [
              "text",
              "unreadable"
            ],
            "title": "Quality",
            "type": "string"
          },
          "text_hash": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Text Hash",
            "type": "string"
          },
          "text_path": {
            "title": "Text Path",
            "type": "string"
          }
        },
        "required": [
          "number",
          "text_path",
          "text_hash",
          "quality"
        ],
        "title": "Page",
        "type": "object"
      },
      "ReviewResult": {
        "additionalProperties": false,
        "description": "A completed result, not a pending job; no invented execution endpoints in MT-01.",
        "properties": {
          "checklist_version": {
            "title": "Checklist Version",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Evidence"
            },
            "title": "Evidence",
            "type": "array"
          },
          "facts": {
            "items": {
              "$ref": "#/$defs/Fact"
            },
            "title": "Facts",
            "type": "array"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/Finding"
            },
            "title": "Findings",
            "type": "array"
          },
          "mode": {
            "enum": [
              "precomputed",
              "fake",
              "replay",
              "real"
            ],
            "title": "Mode",
            "type": "string"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "title": "Schema Version",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "revision_id",
          "mode",
          "created_at",
          "checklist_version",
          "prompt_version",
          "schema_version",
          "facts",
          "evidence",
          "findings"
        ],
        "title": "ReviewResult",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "documents": {
        "items": {
          "$ref": "#/$defs/Document"
        },
        "maxItems": 5,
        "minItems": 1,
        "title": "Documents",
        "type": "array"
      },
      "gold": {
        "$ref": "#/$defs/Gold"
      },
      "id": {
        "format": "uuid",
        "title": "Id",
        "type": "string"
      },
      "key": {
        "pattern": "^(dev|test)-[0-9]{2}$",
        "title": "Key",
        "type": "string"
      },
      "public_demo": {
        "title": "Public Demo",
        "type": "boolean"
      },
      "schema_version": {
        "const": "fixture-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "split": {
        "enum": [
          "dev",
          "test"
        ],
        "title": "Split",
        "type": "string"
      },
      "synthetic": {
        "const": true,
        "title": "Synthetic",
        "type": "boolean"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "title": "Tags",
        "type": "array"
      },
      "title": {
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "id",
      "key",
      "split",
      "title",
      "synthetic",
      "tags",
      "public_demo",
      "documents",
      "gold"
    ],
    "title": "Packet",
    "type": "object"
  }
}
